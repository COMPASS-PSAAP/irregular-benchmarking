diff -ruN abcg.orig/src/comm/numa_comm.hpp abcg.numa/src/comm/numa_comm.hpp
--- x/src/comm/numa_comm.hpp	1969-12-31 17:00:00.000000000 -0700
+++ x/src/comm/numa_comm.hpp	2026-09-29 00:35:24.875033986 -0600
@@ -0,0 +1,22 @@
+#ifndef NUMA_COMM_HPP
+#define NUMA_COMM_HPP
+
+#include "locality_aware.h"
+
+// Perf walk only: one MPIL_Comm for the whole run whose local groups are 14
+// consecutive ranks (one dane NUMA domain; rank r is bound to core r) instead of
+// MPIL_COMM_WORLD's one group per node. MPIL_Comm_update_locality refuses
+// MPIL_COMM_WORLD, and CG() builds new SpMV comm objects on every solve, so the
+// comm is created once on first use and reused.
+inline MPIL_Comm* numa_comm()
+{
+    static MPIL_Comm* xcomm = nullptr;
+    if (xcomm == nullptr)
+    {
+        MPIL_Comm_init(&xcomm, MPI_COMM_WORLD);
+        MPIL_Comm_update_locality(xcomm, 14);
+    }
+    return xcomm;
+}
+
+#endif
