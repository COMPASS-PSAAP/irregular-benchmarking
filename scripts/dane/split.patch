 {
-    int rank, num_procs;
+
+
+
+
+
+
+
+    int rank, num_procs,numa_node;
     MPI_Comm_rank(xcomm->global_comm, &rank);
     MPI_Comm_size(xcomm->global_comm, &num_procs);
+    if (numa_available() != -1) {
+        numa_node = numa_node_of_cpu(sched_getcpu());
